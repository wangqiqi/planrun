{
  "name": "planrun",
  "private": true,
  "version": "1.9.0",
  "description": "PlanRun — DSH-native agent workflow SOP (plan-run-verify) adapted from Super Cursor",
  "homepage": "https://znza.top/planrun/",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./packages/bundle-planrun/presets.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "node scripts/run-bash.mjs scripts/verify-planrun.sh",
    "verify:publish": "node scripts/run-bash.mjs scripts/verify-publish.sh",
    "verify:links": "node scripts/verify-doc-links.mjs",
    "verify:dogfood": "node scripts/run-bash.mjs scripts/verify-dogfood.sh",
    "verify:e2e": "node scripts/run-bash.mjs scripts/verify-plugin-e2e.sh",
    "verify:github": "node scripts/run-bash.mjs scripts/verify-github-install.sh",
    "verify:lib": "node scripts/run-bash.mjs scripts/verify-lib-sync.sh",
    "pack:local": "node scripts/run-bash.mjs scripts/pack-local.sh",
    "publish:packages": "node scripts/run-bash.mjs scripts/publish-packages.sh",
    "gate-check": "node scripts/run-bash.mjs scripts/dsh-guard.sh gate-check",
    "plan-check": "node scripts/run-bash.mjs scripts/dsh-guard.sh plan-check",
    "task-verify": "node scripts/run-bash.mjs scripts/dsh-guard.sh task-verify",
    "next-task": "node scripts/run-bash.mjs scripts/dsh-guard.sh next-task",
    "doctor": "node scripts/run-bash.mjs scripts/dsh-guard.sh doctor",
    "guard": "node scripts/run-bash.mjs scripts/dsh-guard.sh status",
    "verify:npm": "node scripts/run-bash.mjs scripts/verify-npm-install.sh"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "pnpm": ">=10"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "license": "MIT"
}
