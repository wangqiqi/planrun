{
  "name": "planrun",
  "private": true,
  "version": "1.6.1",
  "description": "PlanRun — DSH-native agent workflow SOP (plan-run-verify) adapted from Super Cursor",
  "homepage": "https://znza.top/planrun/",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "./scripts/verify-planrun.sh",
    "verify:publish": "./scripts/verify-publish.sh",
    "verify:dogfood": "./scripts/verify-dogfood.sh",
    "publish:packages": "bash scripts/publish-packages.sh",
    "gate-check": "bash scripts/dsh-guard.sh gate-check",
    "plan-check": "bash scripts/dsh-guard.sh plan-check",
    "task-verify": "bash scripts/dsh-guard.sh task-verify",
    "next-task": "bash scripts/dsh-guard.sh next-task",
    "guard": "bash scripts/dsh-guard.sh status"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "license": "MIT"
}
