# Dependencies
node_modules/
.pnpm-store/
pnpm-debug.log

# Build
lib/
dist/
dist-local/
build/
*.tsbuildinfo
coverage/

# The GitHub-install channel (github:wangqiqi/planrun) has no build step, so the
# three runtime entry points are committed. Only packages/*/lib/*.js ship; the
# declarations and source maps stay ignored build output.
!packages/*/lib/
packages/*/lib/types/
packages/*/lib/*.map

# Vite / VitePress (docs site)
.vite/
**/.vitepress/cache/
**/.vitepress/dist/

# TypeScript emit pollution (packages emit to lib/, not src/)
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map

# Runtime / project-local (do not commit)
.cursorGrowth/
.dsh/growth/
/plan.md
.cursor/rules/local/

# Secrets & local env
.env
.env.*
!.env.example

# Logs & temp
*.log
tmp/
.tmp-*/
.cache/

# OS & editors
.DS_Store
.vscode/
.idea/
