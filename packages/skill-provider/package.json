{
  "name": "@dsh-super/skill-provider",
  "description": "Bundled Super Cursor–adapted skills for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "skills"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-js.mjs",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
