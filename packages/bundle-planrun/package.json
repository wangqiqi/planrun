{
  "name": "@planrun/bundle-planrun",
  "description": "PlanRun profile bundle: mounts @planrun/skill-provider on base-backed profiles",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@planrun/skill-provider": "file:../skill-provider",
    "@planrun/workflow": "file:../workflow"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-js.mjs",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
