{
  "name": "@planrun/bundle",
  "description": "PlanRun profile bundle: mounts @planrun/skill-provider on base-backed profiles",
  "version": "1.7.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets.patch.yml": "./presets.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "presets.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangqiqi/planrun.git",
    "directory": "packages/bundle-planrun"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@planrun/skill-provider": "workspace:^",
    "@planrun/workflow": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-js.mjs",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
